# Leads pipeline (S4.4). Copy to .env.local for development and add the same
# values to the Vercel project (Settings → Environment Variables).
# Without them, dev logs submissions to the console and production shows the
# retry / WhatsApp message instead of saving.

# Google OAuth client, type "Desktop app", from Google Cloud Console
# (APIs & Services → Credentials). Enable the Drive API and Sheets API.
# Publish the consent screen ("In production"); in "Testing" mode refresh tokens expire after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed by: node --env-file=.env.local google-setup.mjs
GOOGLE_REFRESH_TOKEN=
LEADS_SHEET_ID=
LEADS_DRIVE_FOLDER_ID=

# Email alerts via Resend (resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
LEADS_EMAIL_FROM="Al Saadah Website <leads@example.com>"
# Comma-separated list of recipients.
LEADS_EMAIL_TO=sales@example.com
