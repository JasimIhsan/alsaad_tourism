# Leads pipeline (S4.4). Copy to .env.local for development and add the same
# values to the Vercel project (Settings → Environment Variables).
# Without them, dev logs each lead to the console and production shows the
# retry / WhatsApp message instead of saving.
#
# Google Sheet setup (one time):
# 1. Google Cloud Console → create a project → enable the "Google Sheets API".
# 2. IAM & Admin → Service Accounts → create one → Keys → Add key → JSON.
#    Copy "client_email" and "private_key" from the JSON file below.
# 3. Create a Google Sheet with the client's account, then Share it with the
#    service account email as an Editor. Copy the sheet ID from its URL:
#    https://docs.google.com/spreadsheets/d/<LEADS_SHEET_ID>/edit
# 4. Run from app/:  node --env-file=.env.local sheet-setup.mjs
#    It adds the Visa, Flights, Packages and Contact tabs with header rows.

GOOGLE_SERVICE_ACCOUNT_EMAIL=leads-site@your-project.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences, exactly as in the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
LEADS_SHEET_ID=

# Google reviews (S5.1). Without these, the rating badge and reviews section hide themselves.
# 1. Google Cloud Console → enable "Places API (New)" on a project with billing on.
# 2. Credentials → create an API key. Restrict it to the Places API (New). It is only
#    used server-side, so do not add an HTTP referrer restriction.
# 3. Find the business's Place ID (Place ID Finder, or the Google Business Profile).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Email alerts via Resend (resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
LEADS_EMAIL_FROM="Al Saadah Website <leads@example.com>"
# Comma-separated list of recipients.
LEADS_EMAIL_TO=sales@example.com
